model Activity {
  id        String   @id @default(uuid())
  userId    String
  type      String
  movieId   String?
  reviewId  String?
  targetId  String?
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  review Review? @relation(fields: [reviewId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@map("activities")
}
