model Movie {
  id          String @id @default(uuid())
  title       String
  description String
  releaseYear Int
  director    String

  streamingLink String?
  price         Float   @default(0)
  isPremium     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cast        String[]
  language    String?
  duration    Int?
  ageRating   String?
  country     String?
  trailerLink String?
  thumbnail   String?
  banner      String?
  subtitles   String[]
  awards      String[]
  budget      Float?
  boxOffice   Float?
  status      String?
  rating      Float?

  // 🤖 AI Search Field
  embedding Unsupported("vector(1536)")?

  reviews   Review[]
  watchlist Watchlist[]
  genres    MovieGenre[]
}
