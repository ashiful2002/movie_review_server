model Movie {
  id            String   @id @default(uuid())
  title         String
  description   String
  releaseYear   Int
  director      String
  streamingLink String?
  price         Float    @default(0)
  isPremium     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  ageRating     String?
  awards        String[]
  banner        String?
  views         Int      @default(0)
  isFeatured    Boolean? @default(false)

  boxOffice   Float?
  budget      Float?
  cast        String[]
  country     String?
  duration    Int?
  language    String?
  rating      Float?
  status      String?
  subtitles   String[]
  thumbnail   String?
  trailerLink String?
  genres      MovieGenre[]
  reviews     Review[]
  watchlist   Watchlist[]
  favourites  Favourite[]

  @@index([id])
  @@index([title])
  @@map("movies")
}
