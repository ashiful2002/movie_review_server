model SubscriptionPlan {
    id       String @id @default(uuid())
    name     String
    price    Float
    duration Int

    stripePriceId String? @unique
    // optional but useful
    description   String?
    isActive      Boolean @default(true)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // relations
    subscriptions Subscription[]
}
