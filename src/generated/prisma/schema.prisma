model Activity {
  id        String   @id @default(uuid())
  userId    String
  type      String
  movieId   String?
  reviewId  String?
  targetId  String?
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  review Review? @relation(fields: [reviewId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@map("activities")
}

model Admin {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  profilePhoto  String?
  contactNumber String?
  isDeleted     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([isDeleted])
  @@map("admins")
}

model Comment {
  id        String    @id @default(uuid())
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  userId    String
  reviewId  String
  parentId  String?
  parent    Comment?  @relation("CommentToComment", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentToComment")
  review    Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@map("comments")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Favourite {
  id      String @id @default(uuid())
  userId  String
  movieId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@unique([userId, movieId])
  @@map("favourite")
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  follower  User @relation("Followers", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

model Genre {
  id        String  @id @default(uuid())
  name      String  @unique
  slug      String? @unique
  image     String?
  isActive  Boolean @default(true)
  isDeleted Boolean @default(false)

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?
  movies    MovieGenre[]

  @@index([isDeleted])
  @@index([name])
  @@index([slug])
  @@map("genres")
}

model MovieGenre {
  movieId String
  genreId String
  genre   Genre  @relation(fields: [genreId], references: [id])
  movie   Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@id([movieId, genreId])
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  reviewId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  review    Review   @relation(fields: [reviewId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, reviewId])
  @@map("likes")
}

model Movie {
  id            String   @id @default(uuid())
  title         String
  description   String
  releaseYear   Int
  director      String
  streamingLink String?
  price         Float    @default(0)
  isPremium     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  ageRating     String?
  awards        String[]
  banner        String?
  views         Int      @default(0)
  isFeatured    Boolean? @default(false)

  boxOffice   Float?
  budget      Float?
  cast        String[]
  country     String?
  duration    Int?
  language    String?
  rating      Float?
  status      String?
  subtitles   String[]
  thumbnail   String?
  trailerLink String?
  genres      MovieGenre[]
  reviews     Review[]
  watchlist   Watchlist[]
  favourites  Favourite[]

  @@index([id])
  @@index([title])
  @@map("movies")
}

// Feature: Real-time Notifications
model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String // 'review_liked', 'followed', 'subscription_renewed', 'comment_reply'
  title     String
  message   String
  data      Json? // Metadata: reviewId, userId, etc.
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model Payment {
  id              String  @id @default(uuid())
  subscriptionId  String
  userId          String
  amount          Float
  currency        String  @default("USD")
  stripePaymentId String? @unique

  // Payment status
  status PaymentStatus @default(PENDING) // PENDING, COMPLETED, FAILED, REFUNDED

  // Billing info
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  dueDate            DateTime
  paidAt             DateTime?
  failedReason       String?
  retryCount         Int       @default(0)

  user         User         @relation(fields: [userId], references: [id])
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([subscriptionId])
  @@index([status])
  @@map("payments")
}

model DocumentEmbedding {
  id String @id @default(uuid())

  chunkKey    String  @unique
  sourceType  String
  sourceId    String
  sourceLabel String?
  content     String
  metadata    Json?

  embedding Unsupported("vector(2048)")

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([sourceType], name: "idx_document_embeddings_sourceType")
  @@index([sourceId], name: "idx_document_embeddings_sourceId")
  @@map("document_embeddings")
}

model Review {
  id              String           @id @default(uuid())
  rating          Int              @default(0)
  content         String
  tags            String[]
  spoiler         Boolean          @default(false)
  status          ReviewStatus     @default(PENDING)
  isEdited        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  userId          String
  movieId         String
  comments        Comment[]
  likes           Like[]
  movie           Movie            @relation(fields: [movieId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id])
  reviewVotes     ReviewVote[]
  activities      Activity[]
  reviewAnalytics ReviewAnalytics?
}

model ReviewVote {
  id        String   @id @default(uuid())
  userId    String
  reviewId  String
  helpful   Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation("ReviewVotes", fields: [userId], references: [id])

  @@unique([userId, reviewId])
  @@index([reviewId])
  @@map("review_votes")
}

model ReviewAnalytics {
  id             String   @id @default(uuid())
  reviewId       String   @unique
  views          Int      @default(0)
  helpfulCount   Int      @default(0)
  unhelpfulCount Int      @default(0)
  updatedAt      DateTime @updatedAt

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("review_analytics")
}

generator client {
  provider        = "prisma-client-js"
  output          = "../../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model Subscription {
  id     String @id @default(uuid())
  userId String
  planId String

  // Billing dates
  startDate   DateTime  @default(now())
  expiresAt   DateTime // When current period ends
  renewalDate DateTime? // Next auto-renewal (if enabled)

  // Status tracking
  status       SubscriptionStatus @default(ACTIVE) // ACTIVE, EXPIRED, CANCELLED, PAUSED
  cancelledAt  DateTime? // When was it cancelled
  cancelReason String? // Why was it cancelled

  // Billing info
  autoRenew    Boolean @default(true)
  billingCycle Int     @default(1) // Which cycle (1st, 2nd, etc.)

  // Relations
  plan     SubscriptionPlan @relation(fields: [planId], references: [id])
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[] // Link all payments to subscription

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@map("subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PAUSED
}

model SubscriptionPlan {
  id             String   @id @default(uuid())
  name           String // "Basic", "Pro", "Premium"
  durationMonths Int // 1, 3, or 12 (clarity!)
  price          Float // USD
  stripePriceId  String?  @unique
  description    String?
  features       String[] // JSON array of features
  isActive       Boolean  @default(true)

  subscriptions Subscription[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("subscriptionPlans")
}

model User {
  id                    String   @id @default(uuid())
  name                  String
  email                 String   @unique
  password              String
  role                  UserRole @default(USER)
  avatar                String?
  emailVerified         Boolean  @default(false)
  isDeleted             Boolean  @default(false)
  provider              String?
  providerId            String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  isPremium             Boolean  @default(false)
  needPasswordChange    Boolean  @default(true)
  rememberMe            Boolean  @default(false)
  currentSubscriptionId String?

  comments      Comment[]
  likes         Like[]
  payments      Payment[]
  reviews       Review[]
  subscriptions Subscription[]
  watchlist     Watchlist[]
  admin         Admin?
  notifications Notification[]
  activities    Activity[]
  reviewVotes   ReviewVote[]   @relation("ReviewVotes")
  followers     Follow[]       @relation("Followers")
  following     Follow[]       @relation("Following")
  favourites    Favourite[]

  @@map("users")
}

model Watchlist {
  id      String @id @default(uuid())
  userId  String
  movieId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@unique([userId, movieId])
  @@map("watchlists")
}
