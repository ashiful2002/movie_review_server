model Activity {
  id        String   @id @default(uuid())
  userId    String
  type      String
  movieId   String?
  reviewId  String?
  targetId  String?
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  review Review? @relation(fields: [reviewId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@map("activities")
}

model Admin {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  profilePhoto  String?
  contactNumber String?
  isDeleted     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([isDeleted])
  @@map("admins")
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  role          UserRole @default(USER)
  avatar        String?
  emailVerified Boolean  @default(false)
  isDeleted     Boolean  @default(false)
  password      String?
  phone         String?
  street        String?
  city          String?
  postalCode    String?
  address       String?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?
  isPremium          Boolean   @default(false)
  needPasswordChange Boolean   @default(true)
  rememberMe         Boolean   @default(false)

  comments         Comment[]
  likes            Like[]
  payments         Payment[]
  reviews          Review[]
  subscriptions    Subscription[]
  watchlist        Watchlist[]
  admin            Admin?
  notifications    Notification[]
  activities       Activity[]
  reviewVotes      ReviewVote[]   @relation("ReviewVotes")
  followers        Follow[]       @relation("Followers")
  following        Follow[]       @relation("Following")
  favourites       Favourite[]
  sentMessages     Message[]      @relation("sent")
  receivedMessages Message[]      @relation("received")
  movies           Movie[]
  accounts         Account[]
  sessions         Session[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Comment {
  id        String    @id @default(uuid())
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  userId    String
  reviewId  String
  parentId  String?
  parent    Comment?  @relation("CommentToComment", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentToComment")
  review    Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@map("comments")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELLED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Favourite {
  id      String @id @default(uuid())
  userId  String
  movieId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@unique([userId, movieId])
  @@map("favourite")
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  follower  User @relation("Followers", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

model Genre {
  id        String  @id @default(uuid())
  name      String  @unique
  slug      String? @unique
  image     String?
  isActive  Boolean @default(true)
  isDeleted Boolean @default(false)

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?
  movies    MovieGenre[]

  @@index([isDeleted])
  @@index([name])
  @@index([slug])
  @@map("genres")
}

model MovieGenre {
  movieId String
  genreId String
  genre   Genre  @relation(fields: [genreId], references: [id])
  movie   Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@id([movieId, genreId])
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  reviewId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  review    Review   @relation(fields: [reviewId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, reviewId])
  @@map("likes")
}

model Message {
  id         String   @id @default(cuid())
  sender     User     @relation("sent", fields: [senderId], references: [id])
  senderId   String
  receiver   User     @relation("received", fields: [receiverId], references: [id])
  receiverId String
  content    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([senderId])
  @@index([receiverId])
}

model Movie {
  id            String      @id @default(uuid())
  slug          String      @unique
  title         String
  description   String
  releaseYear   Int
  director      String
  streamingLink String?
  reviewCount   Int         @default(0)
  price         Float       @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  awards        String[]
  banner        String?
  views         Int         @default(0)
  isFeatured    Boolean?    @default(false)
  boxOffice     Float?
  budget        Float?
  cast          String[]
  country       String?
  duration      Int?
  language      String[]
  imdbRating    Float?      @default(0)
  averageRating Float?      @default(0)
  status        MovieStatus @default(RELEASED)
  subtitles     String[]
  thumbnail     String?
  trailerLink   String?
  isDeleted     Boolean     @default(false)
  createdById   String?

  createdBy  User?        @relation(fields: [createdById], references: [id])
  genres     MovieGenre[]
  reviews    Review[]
  watchlist  Watchlist[]
  favourites Favourite[]
  userId     String?

  @@index([slug])
  @@index([status])
  @@index([title])
  @@index([isDeleted])
  @@index([releaseYear])
  @@map("movies")
}

enum MovieStatus {
  UPCOMING
  RELEASED
  ARCHIVED
}

// Feature: Real-time Notifications
model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String // 'review_liked', 'followed', 'subscription_renewed', 'comment_reply'
  title     String
  message   String
  data      Json? // Metadata: reviewId, userId, etc.
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model Payment {
  id             String  @id @default(uuid())
  subscriptionId String?

  userId                  String
  amount                  Float
  currency                String        @default("USD")
  stripePaymentIntentId   String?       @unique
  stripeCheckoutSessionId String?       @unique
  stripeInvoiceId         String?       @unique
  receiptUrl              String?
  transactionId           String?
  billingCycle            BillingCycle  @default(MONTHLY)
  status                  PaymentStatus @default(PENDING)

  billingPeriodStart DateTime?
  billingPeriodEnd   DateTime?
  dueDate            DateTime?
  paidAt             DateTime?
  failedReason       String?
  retryCount         Int       @default(0)

  user         User          @relation(fields: [userId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([subscriptionId])
  @@index([createdAt])
  @@map("payments")
}

model DocumentEmbedding {
  id String @id @default(uuid())

  chunkKey    String  @unique
  sourceType  String
  sourceId    String
  sourceLabel String?
  content     String
  metadata    Json?

  embedding Unsupported("vector(2048)")

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([sourceType], name: "idx_document_embeddings_sourceType")
  @@index([sourceId], name: "idx_document_embeddings_sourceId")
  @@map("document_embeddings")
}

model Review {
  id              String           @id @default(uuid())
  rating          Int              @default(0)
  content         String
  tags            String[]
  spoiler         Boolean          @default(false)
  status          ReviewStatus     @default(PENDING)
  isEdited        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  userId          String
  movieId         String
  comments        Comment[]
  likes           Like[]
  movie           Movie            @relation(fields: [movieId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id])
  reviewVotes     ReviewVote[]
  activities      Activity[]
  reviewAnalytics ReviewAnalytics?
}

model ReviewVote {
  id        String   @id @default(uuid())
  userId    String
  reviewId  String
  helpful   Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation("ReviewVotes", fields: [userId], references: [id])

  @@unique([userId, reviewId])
  @@index([reviewId])
  @@map("review_votes")
}

model ReviewAnalytics {
  id             String   @id @default(uuid())
  reviewId       String   @unique
  views          Int      @default(0)
  helpfulCount   Int      @default(0)
  unhelpfulCount Int      @default(0)
  updatedAt      DateTime @updatedAt

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("review_analytics")
}

generator client {
  provider        = "prisma-client-js"
  output          = "../../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model Subscription {
  id     String @id @default(uuid())
  userId String
  planId String

  startDate DateTime @default(now())
  expiresAt DateTime

  status       SubscriptionStatus @default(ACTIVE)
  cancelledAt  DateTime?
  cancelReason String?

  autoRenew    Boolean      @default(true)
  billingCycle BillingCycle

  plan     SubscriptionPlan @relation(fields: [planId], references: [id])
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PAUSED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

model SubscriptionPlan {
  id            String   @id @default(uuid())
  slug          String   @unique
  name          String // "Basic", "Pro", "Premium"
  durationDays  Int // 1, 3, or 12 (clarity!)
  price         Float // USD
  stripePriceId String?  @unique
  description   String?
  features      String[] // JSON array of features
  isActive      Boolean  @default(true)

  subscriptions Subscription[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("subscriptionPlans")
}

